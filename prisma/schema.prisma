generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LeaderboardScore {
  id          String   @id @default(cuid())
  name        String
  nameKey     String   @unique
  score       Int
  streak      Int      @default(0)
  mode        String   @default("mongolian")
  difficulty  String   @default("medium")
  easyScore   Int      @default(0)
  mediumScore Int      @default(0)
  hardScore   Int      @default(0)
  expertScore Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([score(sort: Desc), streak(sort: Desc)])
}

model Comment {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model Challenge {
  id         String            @id @default(cuid())
  code       String            @unique
  mode       String
  difficulty String
  trackIds   Int[]
  hostName   String
  createdAt  DateTime          @default(now())
  expiresAt  DateTime
  results    ChallengeResult[]

  @@index([createdAt(sort: Desc)])
}

model ChallengeResult {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  name        String
  nameKey     String
  score       Int
  streak      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([challengeId, nameKey])
  @@index([challengeId, score(sort: Desc)])
}

/** Live multiplayer lobby / party */
model PartyRoom {
  id           String        @id @default(cuid())
  code         String        @unique
  kind         String        @default("party") // party | duel | streak
  mode         String
  genre        String        @default("all")
  difficulty   String
  status       String        @default("lobby") // lobby | playing | finished
  trackIds     Int[]         @default([])
  hostKey      String
  hostName     String
  maxPlayers   Int           @default(8)
  sharedStreak Boolean       @default(false)
  createdAt    DateTime      @default(now())
  expiresAt    DateTime
  players      PartyPlayer[]

  @@index([createdAt(sort: Desc)])
}

model PartyPlayer {
  id         String    @id @default(cuid())
  roomId     String
  room       PartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name       String
  nameKey    String
  score      Int       @default(0)
  streak     Int       @default(0)
  roundsDone Int       @default(0)
  ready      Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([roomId, nameKey])
  @@index([roomId, score(sort: Desc)])
}
