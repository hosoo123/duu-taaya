generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LeaderboardScore {
  id          String   @id @default(cuid())
  name        String
  nameKey     String   @unique
  score       Int
  streak      Int      @default(0)
  mode        String   @default("mongolian")
  difficulty  String   @default("medium")
  easyScore   Int      @default(0)
  mediumScore Int      @default(0)
  hardScore   Int      @default(0)
  expertScore Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([score(sort: Desc), streak(sort: Desc)])
}

model Comment {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
