# Neon / Vercel Postgres / local Postgres
# Example (Neon):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/duu_taaya?schema=public"

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Site URL (Wire success redirect + SEO)
NEXT_PUBLIC_SITE_URL=https://duutaay.xyz

# Wire donate — https://app.wire.mn/project + https://docs.wire.mn/docs/quickstart
# API mode (recommended):
WIRE_API_KEY=
# Wire dashboard > Webhooks endpoint signing secret
WIRE_WEBHOOK_SECRET=
# Test: sandbox | Live: comma-separated operator ids (e.g. qpay)
WIRE_ALLOWED_OPERATORS=sandbox
# Optional static payment link instead of API (dashboard-аас үүсгэсэн линк):
# NEXT_PUBLIC_WIRE_DONATE_URL=https://pay.wire.mn/...
